# Host folders mounted into the containers.
PIPELINE_RAW_HOST_DIR=./raw
PIPELINE_OUTPUT_HOST_DIR=./output
PIPELINE_STATE_HOST_DIR=./.pipeline

# Container user/group for mounted data. Root maps to the host user with rootless Docker.
PIPELINE_UID=0
PIPELINE_GID=0

# Worker containers, concurrent PDFs per container, and polling interval.
PIPELINE_WORKER_REPLICAS=1
PIPELINE_WORKERS=1
PIPELINE_POLL_SECONDS=5

# Host ChatGPT login only; on Windows set an absolute path such as C:/Users/you/.codex/auth.json.
CODEX_AUTH_FILE_HOST=${HOME}/.codex/auth.json
PIPELINE_OCR_ENABLED=1
# Leave empty to use centralized defaults in backend/app/pipeline/codex/settings.py.
PIPELINE_CODEX_MODEL=
PIPELINE_CODEX_EFFORT=
PIPELINE_CODEX_TIMEOUT_SECONDS=
PIPELINE_OCR_MAX_IMAGE_SIDE=
# For two concurrent OCR calls, set PIPELINE_WORKER_REPLICAS=2,
# PIPELINE_WORKERS=1, and PIPELINE_OCR_CAPACITY=2.
# Apply/recreate workers only after the active batch has finished.
PIPELINE_OCR_CAPACITY=
