# Host folders mounted into the containers.
PIPELINE_RAW_HOST_DIR=./raw
PIPELINE_OUTPUT_HOST_DIR=./output
PIPELINE_STATE_HOST_DIR=./.pipeline

# Read-only Codex login used inside the worker container.
CODEX_AUTH_FILE_HOST=${HOME}/.codex/auth.json

# Container user/group for mounted data. Root maps to the host user with rootless Docker.
PIPELINE_UID=0
PIPELINE_GID=0

# Number of concurrent PDFs per worker container and polling interval in seconds.
PIPELINE_WORKERS=2
PIPELINE_POLL_SECONDS=5
